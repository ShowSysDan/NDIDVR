[Unit]
Description=NDI Recorder
Documentation=https://github.com/ShowSysDan/NDIDVR
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple

# Run as the service account that owns ~/ndi-recorder.
# If you installed under a different username, change User=, Group=,
# WorkingDirectory=, EnvironmentFile=, and ExecStart= to match.
User=ndi
Group=ndi
WorkingDirectory=/home/ndi/ndi-recorder
EnvironmentFile=/home/ndi/ndi-recorder/.env

# NDI SDK library path — adjust if installed elsewhere
Environment=LD_LIBRARY_PATH=/usr/lib/ndi

# Run gunicorn from the project's venv
ExecStart=/home/ndi/ndi-recorder/venv/bin/gunicorn \
    -c /home/ndi/ndi-recorder/gunicorn.conf.py \
    wsgi:app

# Restart policy — come back up fast after crashes or code updates
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Logging — captured by journald (and optionally forwarded to syslog)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ndi-recorder

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

# ─────────────────────────────────────────────────────────────────────────────
# NDI Recorder — Environment Configuration
# Copy to .env and fill in your values before first run.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
HOST=0.0.0.0
PORT=5000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ndi_user:password@localhost:5432/ndi_recorder

# ── S3-Compatible Storage ─────────────────────────────────────────────────────
# Leave S3_ENDPOINT_URL blank for AWS S3.
# Set it for MinIO, Wasabi, Backblaze B2, etc.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=ndi-recordings
S3_REGION=us-east-1
S3_PREFIX=recordings

# ── Local Buffer ──────────────────────────────────────────────────────────────
# Chunks live here until S3 upload is confirmed, then deleted.
LOCAL_BUFFER_DIR=/var/ndi-recorder/buffer
LOCAL_BUFFER_MAX_GB=50

# ── Recording ─────────────────────────────────────────────────────────────────
CHUNK_DURATION_MINUTES=30
NDI_DISCOVERY_TIMEOUT_MS=5000
NDI_RESCAN_INTERVAL_SECONDS=30

# ── Retention ─────────────────────────────────────────────────────────────────
RETENTION_RAW_DAYS=7
RETENTION_COMPRESSED_DAYS=365
# Hour (UTC, 24h) at which the nightly retention/compression job runs
COMPRESSION_SCHEDULE_HOUR=2

# ── Logging ───────────────────────────────────────────────────────────────────
# Leave LOG_DIR blank to log to stdout only (recommended when using systemd/journald)
LOG_DIR=
LOG_LEVEL=INFO

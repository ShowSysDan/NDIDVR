# ─────────────────────────────────────────────────────────────────────────────
# NDI Recorder — Environment Configuration
# Copy to .env and fill in your values before first run.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
HOST=0.0.0.0
PORT=5000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ndi_user:password@localhost:5432/ndi_recorder

# ── S3-Compatible Storage ─────────────────────────────────────────────────────
# Leave S3_ENDPOINT_URL blank for AWS S3.
# Set it for MinIO, Wasabi, Backblaze B2, etc.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=ndi-recordings
S3_REGION=us-east-1
S3_PREFIX=recordings

# ── Local Buffer ──────────────────────────────────────────────────────────────
# Chunks live here until S3 upload is confirmed, then deleted.
LOCAL_BUFFER_DIR=/var/ndi-recorder/buffer
LOCAL_BUFFER_MAX_GB=50

# ── Recording ─────────────────────────────────────────────────────────────────
CHUNK_DURATION_MINUTES=30
NDI_DISCOVERY_TIMEOUT_MS=5000
NDI_RESCAN_INTERVAL_SECONDS=30

# Directory for timelapse JPEG stills (one subfolder per source).
# Stills are written when `timelapse_interval_seconds` is set per-source in the UI.
TIMELAPSE_DIR=/var/ndi-recorder/timelapse

# Start recording the moment the service boots (does NOT wait for the next
# :00/:30 chunk boundary). Set to false to align the first chunk with the
# clock instead.
START_IMMEDIATELY_ON_BOOT=true

# Gap-fill: keep writing duplicate/last frames + silent audio to the output
# file while the NDI source is temporarily dropped. Preserves timing so a
# 1.5 s NDI blip still occupies 1.5 s in the recording.
GAP_FILL_ON_DROP=true

# Run `alembic upgrade head` automatically on startup so a git-pull + service
# restart applies any new migrations with no manual step.
AUTO_MIGRATE_ON_STARTUP=true

# ── Retention ─────────────────────────────────────────────────────────────────
RETENTION_RAW_DAYS=7
RETENTION_COMPRESSED_DAYS=365
# Hour (UTC, 24h) at which the nightly retention/compression job runs
COMPRESSION_SCHEDULE_HOUR=2

# ── Logging ───────────────────────────────────────────────────────────────────
# Leave LOG_DIR blank to log to stdout only (recommended when using systemd/journald)
LOG_DIR=
LOG_LEVEL=INFO

# ── Syslog (optional) ─────────────────────────────────────────────────────────
# Leave SYSLOG_ADDRESS blank to disable syslog.
# Examples:
#   Remote server:  SYSLOG_ADDRESS=logs.example.com   SYSLOG_PORT=514   SYSLOG_PROTOCOL=udp
#   Local syslog:   SYSLOG_ADDRESS=/dev/log
# Facility: user, daemon, local0..local7
# SYSLOG_LEVEL defaults to LOG_LEVEL if blank.
SYSLOG_ADDRESS=
SYSLOG_PORT=514
SYSLOG_PROTOCOL=udp
SYSLOG_FACILITY=user
SYSLOG_IDENT=ndi-recorder
SYSLOG_LEVEL=
